# ─── Backend ─────────────────────────────────────────────────────────────
# Copy to `.env` and fill in real values. Never commit the real .env.

ENVIRONMENT=development           # development | test | staging | production
DEBUG=true

# Database — SQLite for zero-config local dev; swap for Neon Postgres in prod
DATABASE_URL=sqlite:///./remind_ai.db
# DATABASE_URL=postgresql://user:password@host.neon.tech/remind_ai?sslmode=require

# Cache / rate-limit store
REDIS_URL=redis://localhost:6379/0

# Auth (Phase 2 upgrades ALGORITHM to RS256 with a generated key pair)
SECRET_KEY=dev_secret_key_change_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS — comma-separated list of allowed origins
BACKEND_CORS_ORIGINS=http://localhost:3000

# Cloudinary media storage (Phase 3)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ─── Frontend ────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
